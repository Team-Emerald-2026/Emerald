APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja

# 未設定なら管理者アカウントは作らない。本番では必ず強いパスワードを設定する。
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=password
ADMIN_PUBLIC_ACCESS=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret
